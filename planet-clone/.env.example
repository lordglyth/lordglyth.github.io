# Copy this file to .env for local overrides.
# The real .env is ignored by git.

TINY_PLANET_HOST=127.0.0.1
TINY_PLANET_PORT=8765
OLLAMA_URL=http://127.0.0.1:11434

# Soji Core
SOJI_ENABLED=true
SOJI_PROFILE=soji_profile.json
SOJI_TEMPERATURE=0.84
SOJI_USER_AGENT=starlablood/1.0

# Optional only if your Ollama-compatible endpoint expects bearer auth.
OLLAMA_BEARER_TOKEN=
