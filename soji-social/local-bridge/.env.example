# Soji Social local bridge
PORT=3333
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# ---- Soji / Chub ----
# The bridge understands the existing three-variable Soji .env directly.
API_URL=
API_KEY=
MODEL_NAME=soji

# Soji request headers. Defaults match the existing Soji/A.M.I.S setup.
AUTH_HEADER=Authorization
AUTH_PREFIX="Bearer "
EXTRA_HEADER_NAME=User-Agent
EXTRA_HEADER_VALUE=starlablood/1.0

# Optional explicit aliases. Uncomment only when you actually want to override the generic values above.
# SOJI_API_URL=
# SOJI_API_KEY=
# SOJI_MODEL_NAME=soji
# SOJI_AUTH_HEADER=Authorization
# SOJI_AUTH_PREFIX="Bearer "
# SOJI_EXTRA_HEADER_NAME=User-Agent
# SOJI_EXTRA_HEADER_VALUE=starlablood/1.0

# ---- Local LLM providers ----
OLLAMA_URL=http://127.0.0.1:11434
OPENAI_COMPAT_URL=http://127.0.0.1:5000/v1
OPENAI_COMPAT_KEY=

# ---- ComfyUI / Stability Matrix ----
COMFY_URL=http://127.0.0.1:8188
# Directory containing API-format ComfyUI workflow JSON files. The UI lists them automatically.
COMFY_WORKFLOWS_DIR=./workflows
# Optional legacy/default workflow outside that directory.
COMFY_WORKFLOW=
# Optional node overrides for only the legacy/default workflow. Other workflows auto-detect prompt nodes.
COMFY_POSITIVE_NODE_ID=
COMFY_NEGATIVE_NODE_ID=
COMFY_TIMEOUT_MS=180000

# Keep this low when LLM + image generation share one GPU.
PULSE_ACTIONS=1

ALLOWED_ORIGINS=http://127.0.0.1:3333,http://localhost:3333
