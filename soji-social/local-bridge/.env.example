# Soji Social local bridge
PORT=3333

# Ollama (default local LLM provider)
OLLAMA_URL=http://127.0.0.1:11434

# Optional OpenAI-compatible local endpoint (Oobabooga / LM Studio / llama.cpp etc.)
OPENAI_COMPAT_URL=http://127.0.0.1:5000/v1
OPENAI_COMPAT_KEY=

# ComfyUI / Stability Matrix
COMFY_URL=http://127.0.0.1:8188
# Point this at an API-format workflow JSON on your machine.
COMFY_WORKFLOW=./workflows/comfy_sdxl_refiner_api.json
# Node IDs whose inputs.text values receive prompts.
COMFY_POSITIVE_NODE_ID=
COMFY_NEGATIVE_NODE_ID=
COMFY_TIMEOUT_MS=180000

# Keep this low on a 16 GB GPU so LLM + image generation do not dogpile VRAM.
PULSE_ACTIONS=1

# Frontends permitted to control the local bridge.
ALLOWED_ORIGINS=http://127.0.0.1:3333,http://localhost:3333,https://lordglyth.github.io
